// ============================================================
// SAMS — Student Assessment Management System
// Prisma Schema v1.0
// Stack: Next.js + Prisma + PostgreSQL (Neon)
// Auth: Custom (argon2 password hashing + database sessions)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // Neon pooled connection (app runtime)
  directUrl = env("DIRECT_URL")     // Neon direct connection (migrations)
}

// ============================================================
// ENUMS
// ============================================================

// GRANT adds a permission on top of role grants; DENY removes one and
// always wins over any role grant.
enum OverrideEffect {
  GRANT
  DENY
}

enum AssessmentMode {
  INDIVIDUAL
  GROUP
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ResultStatus {
  DRAFT
  PUBLISHED
}

// Present = mark waa dhab, Absent/Exempt = mark waa null
enum AttendanceStatus {
  PRESENT
  ABSENT
  EXEMPT
}

enum EnrollmentStatus {
  ACTIVE
  TRANSFERRED
  DROPPED
  COMPLETED
}

enum Gender {
  MALE
  FEMALE
}

enum StudyMode {
  FT
  PT
}

// FT-only dimension — "Subax" (Morning) vs "Galab" (Afternoon). PT has no
// period split at all. See the "Period" business rule in CLAUDE.md.
enum Period {
  MORNING
  AFTERNOON
}

enum DailyLogType {
  LEAVE_NOTICE
  PROBLEM
  NOTE
}

// All 7 days exist at the DB level, but which ones are actually usable
// for a given class is narrower — see the FT/PT valid-days business rule
// in CLAUDE.md and lib/timetable-days.ts (FT: SAT-WED, PT: THU-FRI; the
// academic week starts Saturday, not Monday).
enum DayOfWeek {
  SUN
  MON
  TUE
  WED
  THU
  FRI
  SAT
}

// ============================================================
// SECURITY — Users, Sessions, Audit
// ============================================================

model User {
  id            String    @id @default(uuid())
  username      String    @unique // staff = email, students = student_no, lecturers (new) = phone number
  // Nullable: ADMIN/DEAN/custom-role staff and legacy lecturer accounts
  // still use email as their login identifier (username == email for
  // them); lecturer accounts generated via Lecturer Accounts (see
  // Lecturer.phoneNumber) have no email at all — username is their phone
  // number instead. Never required at the DB level anymore, but every
  // Users-page-created account (ADMIN/DEAN/custom roles) still requires
  // one via userFormSchema.
  email         String?   @unique
  passwordHash  String    @map("password_hash")
  fullName      String    @map("full_name")
  isActive      Boolean   @default(true) @map("is_active")
  mustChangePw  Boolean   @default(true) @map("must_change_password") // Admin creates account with temp password
  failedLogins  Int       @default(0) @map("failed_logins")
  lockedUntil   DateTime? @map("locked_until") // rate limiting: 5 failed -> lock 15 min
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at") // soft delete

  sessions              Session[]
  studentProfile        Student?
  lecturerProfile       Lecturer?
  auditLogs             AuditLog[]
  assessmentsCreated    Assessment[]       @relation("AssessmentCreator")
  resultsEntered        AssessmentResult[] @relation("ResultEnteredBy")
  resultsPublished      AssessmentResult[] @relation("ResultPublishedBy")
  correctionsMade       ResultCorrection[] @relation("CorrectionBy")
  ownershipTransfersBy  OwnershipTransfer[] @relation("TransferredBy")
  userRoles             UserRole[]
  permissionOverrides   UserPermissionOverride[]
  deanDepartments       DeanDepartment[]
  dailyLogEntriesWritten DailyLogEntry[] @relation("DailyLogAuthor")
  whatsAppTemplatesUpdated WhatsAppMessageTemplate[]

  @@map("users")
}

// ============================================================
// RBAC — roles, permissions, per-user overrides
// Authorization is permission-based (requirePermission in lib/auth);
// role NAMES are used only for presentation (landing page, badge).
// ============================================================

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  // ADMIN/DEAN/LECTURER/STUDENT — cannot be deleted or renamed;
  // their permission grants ARE editable.
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid())
  key         String @unique // e.g. "assessment.publish" — see lib/permissions.ts
  description String
  category    String // grouping for the admin checkbox matrix

  rolePermissions RolePermission[]
  userOverrides   UserPermissionOverride[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id     String @id @default(uuid())
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// Per-user exception on top of role grants. DENY always wins.
model UserPermissionOverride {
  id           String         @id @default(uuid())
  userId       String         @map("user_id")
  permissionId String         @map("permission_id")
  effect       OverrideEffect
  createdAt    DateTime       @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@map("user_permission_overrides")
}

model Session {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  tokenHash      String   @unique @map("token_hash") // kaydi hash-ka, ma aha token-ka cayriin
  expiresAt      DateTime @map("expires_at") // absolute hard ceiling — 7 days from login, never extended
  lastActivityAt DateTime @default(now()) @map("last_activity_at") // bumped on every authenticated request; 30-min idle timeout enforced on top of expiresAt, see lib/auth.ts IDLE_TIMEOUT_MS
  createdAt      DateTime @default(now()) @map("created_at")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt]) // cleanup job: delete expired sessions
  @@map("sessions")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id") // nullable: failed login attempts
  action    String   // e.g. ASSESSMENT_CREATED, MARKS_UPDATED, RESULTS_PUBLISHED, LOGIN, OWNERSHIP_TRANSFERRED
  entity    String   // table/entity name
  entityId  String?  @map("entity_id")
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// ACADEMIC STRUCTURE
// ============================================================

model Department {
  id        String    @id @default(uuid())
  name      String    @unique
  code      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  programs        Program[]
  deanDepartments DeanDepartment[]
  dailyLogEntries DailyLogEntry[]
  lecturers       Lecturer[]

  @@map("departments")
}

// A dean's visible/actionable universe (classes -> students, enrollments,
// assignments, assessments, results, lecturers) is scoped by which
// Departments ("faculties") they oversee here — a dean can hold zero, one,
// or many. Permissions (lib/permissions.ts) define WHAT a dean can do;
// this table defines WHERE. See lib/dean-scope.ts for the query helper
// every dean-facing query/action must apply.
model DeanDepartment {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  departmentId String   @map("department_id")
  createdAt    DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@index([departmentId])
  @@map("dean_departments")
}

// Faculty Daily Log — notes/leave notices/problems logged by Admin or Dean
// against a faculty (Department). Not scoped to a class/course — this is
// faculty-level operational logging, separate from academic data. Written
// by ADMIN (any department) or DEAN (own department(s) only, enforced via
// the same dean_departments/lib/dean-scope.ts pattern as everything else
// dean-scoped — see dailyLogDeanWhere). relatedLecturerId is set for
// LEAVE_NOTICE entries (which lecturer is absent); optional otherwise.
model DailyLogEntry {
  id                String       @id @default(uuid())
  departmentId      String       @map("department_id")
  authorId          String       @map("author_id")
  type              DailyLogType
  relatedLecturerId String?      @map("related_lecturer_id")
  // Optional student reference for NOTE/PROBLEM entries (LEAVE_NOTICE
  // stays lecturer-only — relatedLecturerId above). Never both set on
  // the same row; enforced in admin/daily-log/actions.ts, not a DB
  // constraint.
  relatedStudentId String?      @map("related_student_id")
  title             String
  description       String?
  entryDate         DateTime     @map("entry_date")
  createdAt         DateTime     @default(now()) @map("created_at")

  department      Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  author          User       @relation("DailyLogAuthor", fields: [authorId], references: [id])
  relatedLecturer Lecturer?  @relation(fields: [relatedLecturerId], references: [id], onDelete: SetNull)
  relatedStudent  Student?   @relation(fields: [relatedStudentId], references: [id], onDelete: SetNull)

  @@index([departmentId])
  @@index([entryDate])
  @@map("daily_log_entries")
}

model Program {
  id           String    @id @default(uuid())
  departmentId String    @map("department_id")
  name         String
  code         String    @unique
  createdAt    DateTime  @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")

  department Department @relation(fields: [departmentId], references: [id])
  classes    Class[]

  @@index([departmentId])
  @@map("programs")
}

model AcademicYear {
  id        String    @id @default(uuid())
  name      String    @unique // e.g. "2026-2027"
  startDate DateTime  @map("start_date")
  endDate   DateTime  @map("end_date")
  isActive  Boolean   @default(false) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")

  semesters Semester[]

  @@map("academic_years")
}

model Semester {
  id             String    @id @default(uuid())
  academicYearId String    @map("academic_year_id")
  name           String    // auto-derived "Semester {semesterNumber}"
  // 1 or 2 — an academic year has exactly two. Nullable only for legacy
  // rows migrated before this field existed whose name didn't match a
  // known pattern; an admin must set it via Edit before it's unique-
  // checked against sibling semesters (see @@unique below — a NULL
  // never conflicts with anything, so any number of unmapped legacy
  // rows can coexist per academic year until fixed one at a time).
  semesterNumber Int?      @map("semester_number")
  startDate      DateTime  @map("start_date")
  endDate        DateTime  @map("end_date")
  isActive       Boolean   @default(false) @map("is_active")
  isClosed       Boolean   @default(false) @map("is_closed") // Dean closes semester -> assessments CLOSED
  createdAt      DateTime  @default(now()) @map("created_at")

  academicYear AcademicYear               @relation(fields: [academicYearId], references: [id])
  assignments  LecturerCourseAssignment[]
  enrollments  StudentCourseEnrollment[]

  @@unique([academicYearId, name])
  @@unique([academicYearId, semesterNumber])
  @@map("semesters")
}

model Course {
  id        String    @id @default(uuid())
  name      String
  code      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  assignments LecturerCourseAssignment[]
  enrollments StudentCourseEnrollment[]
  coursePlans ClassCoursePlan[]

  @@map("courses")
}

model Class {
  id        String    @id @default(uuid())
  programId String    @map("program_id")
  // display name — auto-composed as "{batchCode}-{section}-{studyMode}"
  // whenever those three are set; otherwise a manually-typed name
  // (legacy classes migrated before the batch model existed).
  name      String
  batchCode String?    @map("batch_code") // e.g. "CMS26" — auto-derived from program.code + intakeYear at creation, permanent per cohort, never changes
  // The batch's starting/cohort year (e.g. 2026), fixed at creation —
  // NOT the current academic year, which moves on as the batch advances.
  // Stored so an edit later re-shows the ORIGINAL intake year rather than
  // one derived from "now". Only present when batchCode was auto-derived.
  intakeYear Int?      @map("intake_year")
  section   String?    // e.g. "A"
  studyMode StudyMode? @map("study_mode")
  // FT-only: Morning ("Subax") or Afternoon ("Galab") — which half of the
  // day this class's sessions run in. Always null for PT (no period
  // concept). Null on an FT class means its period hasn't been assigned
  // yet — never guessed, see the "Period" migration note in CLAUDE.md.
  // Set explicitly on EACH class row at creation — a promoted class's
  // period does NOT inherit from its predecessor, since a batch can
  // switch periods across semesters.
  period    Period?    @map("period")
  // 1..8 — which semester of its cycle this batch is currently in.
  // Advances via the "Open semester" wizard; students never change
  // class rows for normal progression, only this number moves.
  currentSemesterNumber Int? @map("current_semester_number")
  // The class's single default room — set here at class registration/edit
  // time (Academic Structure > Classes), NOT chosen at scheduling time
  // anymore. Both the drag-and-drop Build Timetable and the auto-timetable
  // generator read this directly and use it for every session of this
  // class; neither asks for a room at build/generate time. Nullable so a
  // class can exist before its room is finalized — required only at
  // build/generate time (validated there, not on class create/update).
  // The pre-existing per-session room OVERRIDE is unaffected — it just no
  // longer doubles as how the class's PRIMARY room gets set.
  roomId    String?   @map("room_id")
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  program     Program                    @relation(fields: [programId], references: [id])
  room        Room?                      @relation(fields: [roomId], references: [id])
  students    Student[]
  assignments LecturerCourseAssignment[]
  enrollments StudentCourseEnrollment[]
  coursePlans ClassCoursePlan[]

  @@unique([programId, name])
  @@map("classes")
}

// Reusable curriculum template: a class's planned course list, per level of
// its semester cycle (a class recurs through semesterNumber 1..8 as its
// batch advances, so the same class can have a different course list at
// each level). Consumed by the "Open semester" wizard to bulk-create
// LecturerCourseAssignments for whichever level a class is advancing into.
model ClassCoursePlan {
  id             String   @id @default(uuid())
  classId        String   @map("class_id")
  courseId       String   @map("course_id")
  semesterNumber Int      @map("semester_number")
  createdAt      DateTime @default(now()) @map("created_at")

  class  Class  @relation(fields: [classId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([classId, semesterNumber, courseId])
  @@map("class_course_plans")
}

// ============================================================
// PROFILES
// ============================================================

model Lecturer {
  id        String  @id @default(uuid())
  // Nullable — mirrors Student.userId: registration (Lecturer
  // Registration) creates only this profile row, no login account.
  // Accounts are generated later, per-lecturer or by department, from the
  // standalone Lecturer Accounts page (see lib/lecturer-accounts.ts-style
  // flow in admin/lecturer-accounts/actions.ts).
  userId    String? @unique @map("user_id")
  staffNo   String  @unique @map("staff_no")
  // Canonical name; set at registration, independent of any account —
  // mirrors Student.fullName (added for the exact same reason: every
  // display of a lecturer's name must work even when userId is null).
  fullName  String  @map("full_name")
  title     String? // e.g. "Dr.", "Eng."
  // The lecturer's home faculty — a plain profile field (NOT a scoping
  // mechanism: dean_departments/lib/dean-scope.ts is unrelated and
  // unaffected by this). Captured at registration; used to filter the
  // Lecturer Accounts list and drive "generate accounts by department".
  departmentId String? @map("department_id")
  // Doubles as the lecturer's WhatsApp notification target (see
  // lib/whatsapp-notify.ts) AND, since this feature, the lecturer's LOGIN
  // IDENTIFIER — User.username is set to this value when an account is
  // generated (see admin/lecturer-accounts/actions.ts), so it must be
  // unique the same way Student.studentNo is. Nullable only for legacy
  // lecturer accounts created before this field existed (still email-based
  // login, untouched) — Lecturer Registration requires it going forward.
  phoneNumber String? @unique @map("phone_number")

  user        User?                      @relation(fields: [userId], references: [id])
  department  Department?                @relation(fields: [departmentId], references: [id])
  assignments LecturerCourseAssignment[]
  dailyLogEntries DailyLogEntry[]
  // OPTIONAL hard scheduling constraint, day+shift granularity — see
  // LecturerAvailability below and CLAUDE.md's "Lecturer availableDays"
  // business rule. Zero rows = fully unrestricted, exactly today's
  // default. Re-entered fresh per generation cycle via the auto-generate
  // wizard, never a permanent Lecturer Registration field.
  availability LecturerAvailability[]

  @@index([departmentId])
  @@map("lecturers")
}

// One row per (lecturer, day) they're available on, optionally narrowed to
// specific shifts that day. shiftId NULL = every shift on this day is
// allowed (day-level only, the original granularity); one or more rows
// with shiftId SET for the same day = ONLY those shifts on this day
// (day+shift level, e.g. Tue: Subax 1st+2nd only, Sat: Subax 2nd+3rd
// only — different shifts on different days for the same lecturer). A day
// with NO row at all is not allowed for this lecturer at all, UNLESS the
// lecturer has zero rows total (then every day/shift is unrestricted —
// the whole-lecturer default). The app layer (never a DB constraint,
// since expressing "at most one NULL-shiftId row XOR N non-null rows per
// day" isn't a clean unique-index shape) guarantees a day never mixes a
// NULL-shiftId row with shift-set rows: saveLecturerAvailableDaysForGeneration
// always replaces a lecturer's ENTIRE rule set atomically per generation
// run (delete-all-then-recreate), so this can't drift.
model LecturerAvailability {
  id         String    @id @default(uuid())
  lecturerId String    @map("lecturer_id")
  dayOfWeek  DayOfWeek @map("day_of_week")
  shiftId    String?   @map("shift_id")

  lecturer Lecturer @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  shift    Shift?   @relation(fields: [shiftId], references: [id])

  @@unique([lecturerId, dayOfWeek, shiftId])
  @@index([lecturerId])
  @@index([shiftId])
  @@map("lecturer_availability")
}

model Student {
  id        String  @id @default(uuid())
  userId    String? @unique @map("user_id") // nullable — registration no longer requires a login account
  studentNo String  @unique @map("student_no")
  fullName  String  @map("full_name") // canonical name; set at registration, independent of any account
  gender    Gender?
  classId   String @map("class_id") // class-ka hadda (current); taariikhda waxaa haya enrollments
  // Optional WhatsApp notification target (see lib/whatsapp-notify.ts).
  // On the Student profile, not User — a student can receive WhatsApp
  // notifications (results published, leave notice, timetable changes)
  // with zero login account, since userId above is nullable and many
  // students never get one.
  phoneNumber String? @map("phone_number")

  user        User?                     @relation(fields: [userId], references: [id])
  class       Class                     @relation(fields: [classId], references: [id])
  enrollments StudentCourseEnrollment[]
  groupMemberships GroupMember[]
  dailyLogEntries DailyLogEntry[]

  @@index([classId])
  @@map("students")
}

// ============================================================
// ASSIGNMENTS & ENROLLMENTS
// ============================================================

model LecturerCourseAssignment {
  id         String   @id @default(uuid())
  lecturerId String   @map("lecturer_id")
  courseId   String   @map("course_id")
  classId    String   @map("class_id")
  semesterId String   @map("semester_id")
  // Weekly teaching load for this assignment, e.g. 1.5, 2.5, 3 — set by the
  // Workload Excel import (see lib/auto-timetable.ts) and consumed by the
  // sequential auto-timetable generator to pick a combination of EXISTING
  // Shift templates whose total duration comes closest to this value.
  // Nullable: assignments created any other way (manual Add Assignment,
  // Bulk Assign, the Open Semester wizard) never set it and are simply not
  // eligible for auto-generation — nothing else in the app reads this
  // field, so leaving it null everywhere else is inert.
  creditHours Decimal? @map("credit_hours") @db.Decimal(4, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  lecturer    Lecturer     @relation(fields: [lecturerId], references: [id])
  course      Course       @relation(fields: [courseId], references: [id])
  class       Class        @relation(fields: [classId], references: [id])
  semester    Semester     @relation(fields: [semesterId], references: [id])
  assessments Assessment[]
  groups      StudentGroup[]
  timetableSlots TimetableSlot[]

  // hal course + class + semester = hal assignment — one lecturer per
  // course/class/semester, full stop (no co-teaching in V1)
  @@unique([courseId, classId, semesterId])
  @@index([lecturerId, semesterId])
  @@map("lecturer_course_assignments")
}

// A physical campus/site a Room belongs to. No department/faculty
// affiliation in the schema (same reasoning as Room itself) — a shared,
// institution-wide entity, unscoped for every timetable.manage holder.
// "Active" status follows this app's universal deletedAt soft-delete
// convention (Department/Program/Room all use the same pattern) rather
// than a separate boolean flag, so Campus deactivate/reactivate works
// identically to every other simple-CRUD entity.
model Campus {
  id        String    @id @default(uuid())
  name      String    @unique
  address   String?
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  rooms Room[]

  @@map("campuses")
}

// A physical/bookable room, belonging to exactly one Campus. No
// department affiliation in the schema (a room is a shared
// institution-wide resource), so it is deliberately UNSCOPED for every
// timetable manager — ADMIN and DEAN both see and pick from the full
// room list, same reasoning as the Daily Log lecturer picker being
// unscoped (no relation to scope it by). Uniqueness is per-campus, not
// global — "Room 101" can legitimately exist at more than one campus,
// which is the whole reason room pickers show "name — campus".
model Room {
  id        String    @id @default(uuid())
  campusId  String    @map("campus_id")
  name      String
  capacity  Int?
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  campus         Campus          @relation(fields: [campusId], references: [id])
  timetableSlots TimetableSlot[]
  // Classes whose DEFAULT room (Class.roomId) is this room — the
  // class-registration-time property, not a per-slot booking (that's
  // timetableSlots above).
  defaultForClasses Class[]

  @@unique([campusId, name])
  @@index([campusId])
  @@map("rooms")
}

// One weekly-recurring scheduled slot for a LecturerCourseAssignment
// (course + class + semester + lecturer, already resolved via the
// assignment). startTime/endTime are "HH:MM" 24h strings, not a DB TIME
// column — avoids timezone-of-a-time-with-no-date ambiguity entirely,
// and zero-padded HH:MM compares correctly both lexicographically and via
// the minutes-since-midnight conversion conflict detection uses (see
// lib/timetable-conflicts.ts). Conflict-free-ness is NOT a DB constraint
// (overlap can't be expressed as a simple unique index) — it's enforced
// in application code before every create/update, same
// query-for-what-exists-before-writing convention used everywhere else in
// this app.
model TimetableSlot {
  id                         String    @id @default(uuid())
  lecturerCourseAssignmentId String    @map("lecturer_course_assignment_id")
  dayOfWeek                  DayOfWeek @map("day_of_week")
  startTime                  String    @map("start_time")
  endTime                    String    @map("end_time")
  roomId                     String    @map("room_id")
  // Manual, per-session, opt-in exception ONLY — never set by the
  // auto-generate algorithm (lib/auto-timetable.ts has no code path that
  // would set this; ScheduledSession carries no such field at all, so a
  // batch-confirmed slot always gets the column default). True means an
  // admin/dean deliberately placed this ONE session on a shift from the
  // OTHER period than its class's own (e.g. a Morning-period class using
  // a Galab shift) — see CLAUDE.md's "Period" business rule's
  // "cross-period override" bullet. Defaults false; the strict
  // own-period-only restriction stays the default everywhere.
  crossPeriodOverride        Boolean   @default(false) @map("cross_period_override")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  assignment LecturerCourseAssignment @relation(fields: [lecturerCourseAssignmentId], references: [id], onDelete: Cascade)
  room       Room                     @relation(fields: [roomId], references: [id])

  @@index([lecturerCourseAssignmentId])
  @@index([roomId])
  @@index([dayOfWeek])
  @@map("timetable_slots")
}

// A reusable time-of-day template, scoped to a studyMode (FT/PT can each
// have their own set — e.g. "Shift 1 (FT): 08:00-12:00", "Shift A (PT):
// 14:00-18:00"). Purely a data-entry convenience: TimetableSlot has NO
// relation to Shift at all, only the plain startTime/endTime strings a
// shift pick copies into the form — picking a shift pre-fills, it never
// locks or constrains the actual slot, and conflict detection always
// works off the resulting time regardless of whether it came from a
// shift or was typed by hand. Same deletedAt soft-delete convention as
// every other simple-CRUD entity in this app (Campus/Room/Department).
model Shift {
  id        String    @id @default(uuid())
  name      String
  studyMode StudyMode @map("study_mode")
  // Required (app-enforced, not a DB constraint) for FT shifts — Morning
  // ("Subax") or Afternoon ("Galab"), e.g. "Subax 1aad" = FT/Morning,
  // "Galab 1aad" = FT/Afternoon. Always null for PT shifts, which have no
  // period split and are unaffected by this field entirely.
  period    Period?   @map("period")
  startTime String    @map("start_time")
  endTime   String    @map("end_time")
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  lecturerAvailability LecturerAvailability[]

  @@unique([studyMode, name])
  @@map("shifts")
}

// GO'AAN #1: marks-ku waxay raacaan enrollment, ma aha class
model StudentCourseEnrollment {
  id         String           @id @default(uuid())
  studentId  String           @map("student_id")
  courseId   String           @map("course_id")
  classId    String           @map("class_id")
  semesterId String           @map("semester_id")
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now()) @map("enrolled_at")
  // haddii transfer dhaco: enrollment cusub ayaa la abuuraa,
  // kanina wuxuu noqdaa TRANSFERRED — marks-kiisu way la joogaan
  transferredToId String?     @unique @map("transferred_to_id")

  student       Student                  @relation(fields: [studentId], references: [id])
  course        Course                   @relation(fields: [courseId], references: [id])
  class         Class                    @relation(fields: [classId], references: [id])
  semester      Semester                 @relation(fields: [semesterId], references: [id])
  transferredTo StudentCourseEnrollment? @relation("EnrollmentTransfer", fields: [transferredToId], references: [id])
  transferredFrom StudentCourseEnrollment? @relation("EnrollmentTransfer")
  results       AssessmentResult[]

  // student-ku ma yeelan karo laba enrollment ACTIVE ah oo isku course+semester
  // (partial unique index — ku dar migration SQL gacanta, eeg NOTES.md)
  @@unique([studentId, courseId, semesterId, status], name: "uniq_active_enrollment")
  @@index([classId, semesterId])
  @@map("student_course_enrollments")
}

// ============================================================
// ASSESSMENTS
// ============================================================

// configurable types — Admin ayaa ku dari kara noocyo cusub
model AssessmentType {
  id        String    @id @default(uuid())
  name      String    @unique // Quiz, Assignment, Lab, Presentation, Project, Class Work...
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")

  assessments Assessment[]

  @@map("assessment_types")
}

model Assessment {
  id               String           @id @default(uuid())
  assignmentId     String           @map("assignment_id") // lecturer+course+class+semester
  assessmentTypeId String           @map("assessment_type_id")
  title            String
  maximumMarks     Decimal          @map("maximum_marks") @db.Decimal(5, 2)
  mode             AssessmentMode
  status           AssessmentStatus @default(DRAFT)
  createdBy        String           @map("created_by") // OWNERSHIP — only creator edits
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  deletedAt        DateTime?        @map("deleted_at")

  assignment     LecturerCourseAssignment @relation(fields: [assignmentId], references: [id])
  assessmentType AssessmentType           @relation(fields: [assessmentTypeId], references: [id])
  creator        User                     @relation("AssessmentCreator", fields: [createdBy], references: [id])
  results        AssessmentResult[]
  transfers      OwnershipTransfer[]

  @@index([assignmentId])
  @@index([createdBy])
  @@map("assessments")
}

// GO'AAN #7: Dean transfers ownership — audit-ka gaarka ah
model OwnershipTransfer {
  id            String   @id @default(uuid())
  assessmentId  String   @map("assessment_id")
  fromLecturer  String   @map("from_lecturer_user_id")
  toLecturer    String   @map("to_lecturer_user_id")
  transferredBy String   @map("transferred_by") // Dean user id
  reason        String
  createdAt     DateTime @default(now()) @map("created_at")

  assessment Assessment @relation(fields: [assessmentId], references: [id])
  dean       User       @relation("TransferredBy", fields: [transferredBy], references: [id])

  @@index([assessmentId])
  @@map("ownership_transfers")
}

// ============================================================
// GROUPS — course-level, reusable across assessments
// (GO'AAN #4: snapshot model — mark waa copy, group_id waa reference)
// ============================================================

model StudentGroup {
  id           String   @id @default(uuid())
  assignmentId String   @map("assignment_id")
  name         String   // "Group A"
  createdAt    DateTime @default(now()) @map("created_at")

  assignment LecturerCourseAssignment @relation(fields: [assignmentId], references: [id])
  members    GroupMember[]

  @@unique([assignmentId, name])
  @@map("student_groups")
}

model GroupMember {
  id        String @id @default(uuid())
  groupId   String @map("group_id")
  studentId String @map("student_id")
  // denormalized si constraint-ka loo dhaqan geliyo:
  assignmentId String @map("assignment_id")

  group   StudentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student Student      @relation(fields: [studentId], references: [id])

  // GO'AAN #5: student-ku ma geli karo wax ka badan hal group per course assignment
  @@unique([assignmentId, studentId])
  @@index([groupId])
  @@map("group_members")
}

// ============================================================
// RESULTS
// ============================================================

model AssessmentResult {
  id           String           @id @default(uuid())
  assessmentId String           @map("assessment_id")
  enrollmentId String           @map("enrollment_id") // GO'AAN #1: xiriirka waa enrollment
  groupId      String?          @map("group_id") // nullable — reference keliya (snapshot model)
  // GO'AAN #6: decimal marks. Nullable: ABSENT/EXEMPT = null mark
  mark             Decimal?         @db.Decimal(5, 2)
  attendanceStatus AttendanceStatus @default(PRESENT) @map("attendance_status")
  feedback         String?
  status           ResultStatus     @default(DRAFT)
  isCorrected      Boolean          @default(false) @map("is_corrected") // "Corrected" badge student-ka
  enteredBy        String           @map("entered_by")
  publishedBy      String?          @map("published_by")
  publishedAt      DateTime?        @map("published_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at") // optimistic locking

  assessment  Assessment              @relation(fields: [assessmentId], references: [id])
  enrollment  StudentCourseEnrollment @relation(fields: [enrollmentId], references: [id])
  enteredUser User                    @relation("ResultEnteredBy", fields: [enteredBy], references: [id])
  publishUser User?                   @relation("ResultPublishedBy", fields: [publishedBy], references: [id])
  corrections ResultCorrection[]

  // hal student (enrollment), hal assessment = hal result
  @@unique([assessmentId, enrollmentId])
  @@index([enrollmentId])
  @@index([status])
  @@map("assessment_results")
}

// GO'AAN #3: Option A — correction toos ah + audit aan la tirtiri karin
model ResultCorrection {
  id          String   @id @default(uuid())
  resultId    String   @map("result_id")
  oldMark     Decimal? @map("old_mark") @db.Decimal(5, 2)
  newMark     Decimal? @map("new_mark") @db.Decimal(5, 2)
  reason      String   // MANDATORY
  correctedBy String   @map("corrected_by")
  createdAt   DateTime @default(now()) @map("created_at")

  result    AssessmentResult @relation(fields: [resultId], references: [id])
  corrector User             @relation("CorrectionBy", fields: [correctedBy], references: [id])

  @@index([resultId])
  @@map("result_corrections")
}

// ============================================================
// WHATSAPP NOTIFICATIONS — best-effort, unofficial, entirely optional.
// See lib/whatsapp-notify.ts and CLAUDE.md's "WhatsApp Notifications"
// section. This is NOT the official Meta Business API — it drives a real
// WhatsApp number via an unofficial library (self-hosted, on a separate
// VPS process), which risks that number being banned. The main app must
// stay fully functional with this entire feature off; nothing here is a
// dependency of any core academic flow.
// ============================================================

enum WhatsAppEventType {
  RESULTS_PUBLISHED
  LEAVE_NOTICE
  TIMETABLE_CHANGE
}

enum WhatsAppNotificationStatus {
  PENDING
  SENT
  FAILED
}

// Doubles as both the outbox QUEUE (the separate VPS worker polls for
// PENDING rows, sends, and updates the status) and the delivery LOG (what
// the admin page shows, including manual retry — which just flips a
// FAILED row back to PENDING for the next poll). recipientType/recipientId
// mirror AuditLog's entity/entityId shape on purpose: no FK, since the
// recipient is polymorphic (Student or Lecturer) and may later be
// deleted — recipientName/phoneNumber are snapshotted at enqueue time so
// the log stays readable either way.
model WhatsAppNotificationLog {
  id            String                     @id @default(uuid())
  recipientType String                     @map("recipient_type") // "STUDENT" | "LECTURER"
  recipientId   String                     @map("recipient_id") // Student.id or Lecturer.id — no FK, see above
  recipientName String                     @map("recipient_name") // snapshot at enqueue time
  phoneNumber   String                     @map("phone_number") // snapshot at enqueue time
  eventType     WhatsAppEventType          @map("event_type")
  entity        String // mirrors AuditLog's entity/entityId convention, e.g. "Assessment"
  entityId      String?                    @map("entity_id")
  message       String                     @db.Text
  status        WhatsAppNotificationStatus @default(PENDING)
  attempts      Int                        @default(0)
  lastError     String?                    @map("last_error")
  createdAt     DateTime                   @default(now()) @map("created_at")
  updatedAt     DateTime                   @updatedAt @map("updated_at")
  sentAt        DateTime?                  @map("sent_at")

  @@index([status])
  @@index([recipientType, recipientId])
  @@index([createdAt])
  @@map("whatsapp_notification_logs")
}

// Single-row settings + live status, coordinated entirely through this
// table — the Next.js app (Vercel) and the WhatsApp worker (VPS) never
// call each other directly, only read/write this shared Postgres row.
// Always exactly one row, id = WHATSAPP_SETTINGS_ID ("singleton") in
// lib/whatsapp-notify.ts; enforced by application code (migration
// inserts it once), not a DB constraint. connectionStatus is a plain
// string, not an enum, deliberately: it's written exclusively by the
// separately-deployed worker process, which shouldn't need a Prisma
// migration on this app to introduce a new status value. Allowed values
// (by convention, not a DB constraint): "CONNECTED", "DISCONNECTED",
// "NEEDS_QR_SCAN".
model WhatsAppSettings {
  id               String    @id
  enabled          Boolean   @default(false)
  connectionStatus String    @default("DISCONNECTED") @map("connection_status")
  lastHeartbeatAt  DateTime? @map("last_heartbeat_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("whatsapp_settings")
}

// Customizable message text per notification trigger — exactly one row
// per WhatsAppEventType. Seeded (migration `whatsapp_message_templates`)
// with the exact hardcoded text each trigger used before this model
// existed (see lib/whatsapp-templates.ts's DEFAULT_WHATSAPP_TEMPLATES),
// so nothing changes until an admin edits one. templateText supports
// {placeholder} tokens; the known set per eventType lives in
// lib/whatsapp-templates.ts (code), not this table — an unknown
// placeholder is rejected at save time (admin/whatsapp/actions.ts) and,
// as a defense in depth, ignored at send time (lib/whatsapp-notify.ts
// falls back to the default rather than risk a broken/literal "{typo}"
// reaching an outgoing message).
model WhatsAppMessageTemplate {
  id           String            @id @default(uuid())
  eventType    WhatsAppEventType @unique @map("event_type")
  templateText String            @map("template_text") @db.Text
  updatedBy    String?           @map("updated_by") // null until first edited
  updatedAt    DateTime          @updatedAt @map("updated_at")

  updatedByUser User? @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("whatsapp_message_templates")
}
