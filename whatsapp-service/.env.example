# Point this at the SAME Postgres database the main SAMS app uses (Neon).
# Use the DIRECT (non-pooled) connection string — this is a long-running
# process holding a persistent pool of its own, not serverless, so it
# should not go through the pooled/pgbouncer endpoint.
DATABASE_URL=

# How often (ms) to poll whatsapp_notification_logs for PENDING rows.
POLL_INTERVAL_MS=5000

# How often (ms) to write a heartbeat + refresh connection status into
# whatsapp_settings, so the admin page can tell a stale/dead worker from
# a genuinely connected one.
HEARTBEAT_INTERVAL_MS=30000

# Where Baileys persists the WhatsApp Web session (auth credentials) so
# the process doesn't need the QR code re-scanned on every restart. Back
# this up / keep it on persistent disk — deleting it forces a re-scan.
SESSION_DIR=./auth_session

# Optional — sidesteps QR scanning entirely. If set (E.164 digits, no
# "+", e.g. 252611111111), the worker requests an 8-character pairing
# code instead of a QR: WhatsApp on that phone -> Settings -> Linked
# Devices -> Link a Device -> "Link with phone number instead" -> type
# the code the worker logs. Leave blank to use the normal QR flow.
PAIRING_PHONE_NUMBER=
